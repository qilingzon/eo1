---
export const prerender = true;


import type { GetStaticPaths } from "astro";

import { PAGE_SIZE } from "@constants/constants";
import { siteConfig } from "@/config";
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrl } from "@utils/url-utils";
import Pagination from "@components/pagination.astro";
import PostPage from "@components/postPage.astro";
import PostSort from "@components/postSort.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";


export const getStaticPaths = (async ({ paginate }) => {
    const allBlogPosts = await getSortedPosts();

    const sorts = [
        { name: undefined, data: allBlogPosts },
        { name: "date-asc", data: [...allBlogPosts].reverse() },
        {
            name: "alpha-asc",
            data: [...allBlogPosts].sort((a, b) =>
                a.data.title.localeCompare(b.data.title, "zh-CN"),
            ),
        },
        {
            name: "alpha-desc",
            data: [...allBlogPosts].sort((a, b) =>
                b.data.title.localeCompare(a.data.title, "zh-CN"),
            ),
        },
    ];

    return sorts.flatMap((sort) => {
        const pages = paginate(sort.data, {
            pageSize: PAGE_SIZE,
            props: { sort: sort.name },
        });

        return pages.map((p) => {
            if (sort.name) {
                p.params.page = p.params.page
                    ? `${sort.name}/${p.params.page}`
                    : sort.name;
            }
            return p;
        });
    });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992


const { page, sort } = Astro.props;

const len = page.data.length;

const getCanonicalPath = () => {
    if (!sort) return page.url.current;
    return page.currentPage === 1 ? "/" : `/${page.currentPage}/`;
};

const canonicalUrl = new URL(getCanonicalPath(), Astro.url).toString();
const prevUrl = page.url.prev ? new URL(page.url.prev, Astro.url).toString() : undefined;
const nextUrl = page.url.next ? new URL(page.url.next, Astro.url).toString() : undefined;

const websiteJsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.title,
    url: Astro.site,
    description: siteConfig.subtitle,
};

const itemListJsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: page.currentPage === 1 ? siteConfig.title : `${siteConfig.title} - 第 ${page.currentPage} 页`,
    url: canonicalUrl,
    mainEntity: {
        "@type": "ItemList",
        itemListElement: page.data.map((entry, index) => ({
            "@type": "ListItem",
            position: (page.currentPage - 1) * PAGE_SIZE + index + 1,
            name: entry.data.title,
            url: new URL(getPostUrl(entry), Astro.url).toString(),
        })),
    },
};
---

<MainGridLayout title={page.currentPage === 1 ? undefined : `第 ${page.currentPage} 页`}>
    <link slot="head" rel="canonical" href={canonicalUrl} />
    {!sort && prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
    {!sort && nextUrl && <link slot="head" rel="next" href={nextUrl} />}
    {sort && <meta slot="head" name="robots" content="noindex,follow" />}
    {page.currentPage === 1 && !sort && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>}
    {!sort && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)}></script>}
    <PostSort sort={sort} class="onload-animation" style="animation-delay: var(--content-delay);"></PostSort>
    <PostPage page={page}></PostPage>
    <Pagination sort={sort} class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len) * 50}ms)`}></Pagination>
</MainGridLayout>